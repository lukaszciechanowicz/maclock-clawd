[Unit]
Description=Maclock Clawd native landscape desk companion
After=systemd-user-sessions.service getty@tty1.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=pipclock
Group=pipclock
SupplementaryGroups=video render input gpio
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
WorkingDirectory=/opt/maclock-clawd
StateDirectory=pipclock
StateDirectoryMode=0700
Environment=PYTHONUNBUFFERED=1
Environment=PIPCLOCK_HOST=127.0.0.1
Environment=PIPCLOCK_IDLE_CONFIG=/var/lib/pipclock/idle.json
Environment=PIPCLOCK_BUTTON_PREV=19
Environment=PIPCLOCK_BUTTON_NEXT=26
Environment=SDL_VIDEODRIVER=kmsdrm
# VC4 exposes GLES2; SDL's desktop OpenGL framebuffer path can scan out black.
Environment=SDL_FRAMEBUFFER_ACCELERATION=opengles2
EnvironmentFile=-/etc/pipclock.env
# No --preview: native rendering only, with no JPEG encoding.
ExecStart=/usr/bin/python3 -m pipclock --host ${PIPCLOCK_HOST} --port 8765 --fullscreen --rotation 90
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=multi-user.target
